# ============================================================
# 80. FINAL SAFETY RULES
# ============================================================

# Never commit private key material
*.pem
*.key
*.p12
*.pfx

# Never commit credential files
credentials.json
**/credentials.json

# Never commit local secrets
.env.local
**/.env.local

# Never commit dependency directories
node_modules/
**/node_modules/

# Never commit build output
dist/
**/dist/

# Never commit coverage
coverage/
**/coverage/

# Never commit local caches
.cache/
**/.cache/

# Keep Git itself tracked
!.gitignore

# Keep package manager lockfiles
!package-lock.json
!yarn.lock
!pnpm-lock.yaml

# Keep environment templates
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
